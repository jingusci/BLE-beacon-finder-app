@startuml ArquitecturaConceptualBLEBeaconFinder
title BLE Beacon Finder - Arquitectura conceptual

left to right direction

skinparam shadowing false
skinparam linetype polyline
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam rectangle {
  BackgroundColor #F8F8F8
  BorderColor #444444
  RoundCorner 8
}
skinparam note {
  BackgroundColor #FFF8CC
  BorderColor #777777
}

actor "Usuario" as User

rectangle "Mundo fisico" as PhysicalWorld {
  rectangle "Beacons ESP32-C6\nemiten iBeacon por ambiente" as Beacons
}

rectangle "Telefono Android" as Phone {
  rectangle "App BLE Beacon Finder" as App {
    rectangle "Buscar beacon\nmas cercano" as Search
    rectangle "Ver beacons\ndetectados" as Monitor
    rectangle "Administrar\nbeacons conocidos" as ManageBeacons
    rectangle "Administrar\naudios" as ManageAudio

    rectangle "Procesamiento BLE\nescaneo + lectura iBeacon" as BleProcessing
    rectangle "Catalogo local\nbeacons + audios asignados" as Catalog
    rectangle "Salida al usuario\ntexto + audio" as Feedback
  }

  rectangle "Soporte del telefono" as PhoneSupport {
    rectangle "Servicios del sistema" as SystemServices {
      rectangle "Bluetooth LE" as Bluetooth
      rectangle "Permisos y ubicacion" as Permissions
      rectangle "Audio" as SystemAudio
    }

    rectangle "Datos locales" as LocalData {
      rectangle "Beacons conocidos" as KnownBeacons
      rectangle "Audios grabados" as CustomAudios
      rectangle "Audios incluidos" as BuiltInAudios
      rectangle "Preferencias" as Preferences
    }
  }
}

User --> Search
User --> Monitor
User --> ManageBeacons
User --> ManageAudio

Beacons --> Bluetooth : anuncios BLE
Permissions --> BleProcessing : autoriza escaneo
Bluetooth --> BleProcessing : resultados detectados

Search --> BleProcessing
Monitor --> BleProcessing
BleProcessing --> Catalog : UUID / major / minor / RSSI
Catalog --> Feedback : beacon reconocido\nmas cercano

ManageBeacons --> Catalog : altas, ediciones,\nbajas
ManageAudio --> Catalog : asigna audios
ManageAudio -- CustomAudios : graba o elimina

Catalog -- KnownBeacons
Catalog -- Preferences
Feedback -- BuiltInAudios
Feedback -- CustomAudios
Feedback -- SystemAudio : reproduce audio

App -[hidden]down- PhoneSupport
SystemServices -[hidden]right- LocalData

@enduml
